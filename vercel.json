{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/nasa.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/nasa/:path+", "destination": "/api/nasa?__path=:path" }
  ]
}
